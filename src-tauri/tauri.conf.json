{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Textream",
  "version": "1.0.0",
  "identifier": "dev.crtkafa.textream",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Textream",
        "url": "index.html",
        "width": 1000,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "overlay",
        "title": "Textream Overlay",
        "url": "overlay.html",
        "width": 420,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/onnxruntime.dll": "onnxruntime.dll",
      "runtime/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "runtime/sherpa-onnx-c-api.dll": "sherpa-onnx-c-api.dll",
      "runtime/sherpa-onnx-cxx-api.dll": "sherpa-onnx-cxx-api.dll",
      "runtime/cargs.dll": "cargs.dll"
    },
    "copyright": "Copyright (c) 2026 CRTkafa",
    "shortDescription": "Teleprompter for Windows",
    "longDescription": "A free Windows teleprompter with real-time word tracking, classic auto-scroll and voice-activated scrolling. Everything runs on-device.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
